// Schéma de la base filemoica.
//
// ## Principe directeur
//
// Une fuite de la base seule ne doit rien donner d'exploitable. Trois moyens :
//
//   1. Chiffrement enveloppe. Le contenu des fichiers vit sur le disque,
//      chiffré par une clé propre à chaque fichier (DEK). Seule cette DEK est
//      en base, elle-même chiffrée par la clé maître (KEK) qui, elle, n'est
//      QUE dans les variables d'environnement. Sans le `.env`, les colonnes
//      `dek_wrapped` ne servent à rien.
//   2. Champs sensibles chiffrés. Noms de fichiers et emails de destinataires
//      sont stockés chiffrés en AES-256-GCM.
//   3. Jetons hachés. Ni les liens de partage ni les refresh tokens ne sont
//      stockés en clair : seulement leur SHA-256. Voler la base ne permet donc
//      pas de rejouer un lien.
//
// ## Format des colonnes chiffrées
//
// Les colonnes suffixées `_enc` contiennent une chaîne compacte :
//
//     <version>.<iv_base64>.<authTag_base64>.<chiffré_base64>
//
// Tout tenir dans une colonne évite d'en multiplier trois par champ chiffré.
//
// ## Ce qui reste en clair, et pourquoi
//
// `users.email` : le login doit pouvoir chercher par email. Le chiffrer
// imposerait un index aveugle pour un gain faible — la donnée sensible d'un
// partage, c'est l'email du destinataire, et celui-là est chiffré.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// Offre souscrite. Détermine le volume mensuel autorisé.
///
/// Le passage en `PREMIUM` se fait pour l'instant directement en base : le
/// service démontre la mécanique du quota, pas l'encaissement. Brancher un
/// prestataire de paiement reviendrait à écrire cette même valeur après une
/// transaction réussie.
enum Plan {
  FREE
  PREMIUM
}

/// Compte utilisateur.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// En clair : sert de critère de recherche à la connexion.
  email String @unique

  /// Empreinte argon2id. Le mot de passe lui-même n'existe nulle part.
  passwordHash String @map("password_hash")

  /// La double authentification est-elle active sur ce compte ?
  ///
  /// Désactivée par défaut : l'imposer à tous ferait dépendre chaque connexion
  /// d'un envoi de courriel, y compris pour les comptes de démonstration dont
  /// l'adresse n'existe pas.
  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  /// Date de confirmation de l'adresse. Nulle tant qu'elle ne l'est pas :
  /// la connexion est alors refusée.
  emailVerifiedAt DateTime? @map("email_verified_at")
  role      Role     @default(USER)
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now()) @map("created_at")

  files         File[]
  shares        Share[]
  refreshTokens RefreshToken[]
  emailVerifications EmailVerification[]
  mfaChallenges      MfaChallenge[]
  monthlyUsage  MonthlyUsage[]

  @@map("users")
}

/// Volume déposé par un compte au cours d'un mois.
///
/// ## Pourquoi une table plutôt qu'une somme sur `files`
///
/// Additionner la taille des fichiers présents mesurerait l'espace **occupé**,
/// pas le volume **déposé** : supprimer un fichier rendrait du quota, et il
/// suffirait d'envoyer puis d'effacer en boucle pour contourner l'offre.
///
/// Ce compteur ne bouge qu'à la hausse. Une ligne par mois et par compte, donc
/// aucune remise à zéro à programmer : le mois suivant crée simplement une
/// nouvelle ligne.
model MonthlyUsage {
  id String @id @default(uuid()) @db.Uuid

  /// Mois concerné, au format `AAAA-MM`.
  period String

  /// Cumul en octets. `BigInt` car une offre payante dépasse les 2 Go que
  /// peut représenter un entier 32 bits.
  bytes BigInt @default(0)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("monthly_usage")
}

/// Un fichier déposé. Son contenu est sur le disque, jamais en base.
model File {
  id String @id @default(uuid()) @db.Uuid

  /// Nom aléatoire sur le disque. Le nom d'origine n'y apparaît jamais :
  /// un simple `ls` du répertoire de stockage ne révèle rien.
  storageName String @unique @map("storage_name")

  /// Nom d'origine, chiffré.
  originalNameEnc String @map("original_name_enc")

  /// Clé du fichier (DEK), chiffrée par la clé maître.
  dekWrapped String @map("dek_wrapped")

  /// Version de la clé maître ayant chiffré la DEK. C'est ce qui permet une
  /// rotation : on re-chiffre les DEK, pas les fichiers.
  keyVersion String @default("v1") @map("key_version")

  /// Vecteur d'initialisation du contenu, unique par fichier.
  contentIv String @map("content_iv")

  /// Tag d'authentification GCM du contenu. Il détecte toute altération du
  /// fichier sur le disque : sans lui, on servirait un fichier corrompu.
  contentAuthTag String @map("content_auth_tag")

  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  shares ShareFile[]

  @@index([ownerId])
  @@map("files")
}

/// Un lien de partage vers un ou plusieurs fichiers, à destination d'un email
/// précis. Un même lien couvre toute une session de dépôt : le destinataire
/// n'a qu'une seule adresse à ouvrir pour récupérer l'ensemble.
model Share {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 du jeton. Le jeton en clair n'est montré qu'une fois, à la
  /// création : la base ne permet pas de le reconstituer.
  tokenHash String @unique @map("token_hash")

  /// Email du destinataire, chiffré. Facultatif.
  ///
  /// **Informatif : ne conditionne pas l'accès.** Le lien se suffit à lui-même,
  /// et son destinataire n'a pas besoin de compte. Cet email sert à savoir à qui
  /// un partage était destiné, et servira à la notification.
  recipientEmailEnc String? @map("recipient_email_enc")

  /// Index aveugle de l'email, pour retrouver les partages faits à une adresse
  /// sans avoir à déchiffrer toute la table.
  recipientEmailHmac String? @map("recipient_email_hmac")

  /// Durée de vie du lien, choisie par le déposant.
  expiresAt DateTime @map("expires_at")

  /// Mot de passe du lien, haché en argon2id. Facultatif.
  ///
  /// Quand il est présent, le lien seul ne suffit plus : c'est le second
  /// facteur qui protège un lien intercepté, transféré ou publié par erreur.
  passwordHash String? @map("password_hash")

  /// Lien à usage unique : il se consume au premier téléchargement réussi.
  ///
  /// Quand le fichier n'a plus aucun autre lien exploitable, il est alors
  /// **effacé du serveur**. C'est la garantie la plus forte que le service
  /// puisse offrir : la donnée ne survit pas à sa transmission.
  burnAfterDownload Boolean @default(false) @map("burn_after_download")

  /// Date du téléchargement qui a consumé le lien. Nulle tant qu'il est vierge.
  ///
  /// Sert aussi de verrou : une mise à jour conditionnée à sa nullité garantit
  /// qu'un seul téléchargement simultané l'emporte.
  consumedAt DateTime? @map("consumed_at")

  /// Révocation manuelle, indépendante de l'expiration.
  revoked   Boolean   @default(false)
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Créateur du lien.
  ///
  /// Redondant avec le propriétaire des fichiers couverts, et c'est voulu : un
  /// lien à usage unique survit à l'effacement de ses fichiers, et sans cette
  /// colonne il disparaîtrait de la liste de son créateur au moment précis où
  /// celui-ci veut vérifier que le transfert a bien eu lieu.
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  files ShareFile[]

  @@index([ownerId])
  @@index([recipientEmailHmac])
  @@map("shares")
}

/// Association entre un partage et un fichier qu'il couvre.
///
/// Table de jointure plutôt qu'un `fileId` unique sur `Share` : un partage
/// représente une session de dépôt entière, potentiellement plusieurs
/// fichiers, derrière un seul jeton.
model ShareFile {
  shareId String @map("share_id") @db.Uuid
  fileId  String @map("file_id") @db.Uuid

  /// Date à laquelle ce fichier a été téléchargé via ce lien.
  ///
  /// N'a de sens que sur un lien à usage unique, où elle sert de verrou : une
  /// mise à jour conditionnée à sa nullité garantit qu'un seul téléchargement
  /// simultané l'emporte. Le lien n'est consommé qu'une fois **tous** ses
  /// fichiers marqués.
  downloadedAt DateTime? @map("downloaded_at")

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([shareId, fileId])
  @@index([fileId])
  @@map("share_files")
}

/// Refresh token, stocké haché.
///
/// `familyId` regroupe tous les jetons issus d'une même connexion. Si un jeton
/// déjà utilisé est rejoué, c'est qu'il a été volé : on révoque alors la
/// famille entière plutôt que ce seul jeton.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 du jeton opaque envoyé au client.
  tokenHash String @unique @map("token_hash")

  /// Identifiant de la lignée de jetons, conservé à chaque rotation.
  familyId String @map("family_id") @db.Uuid

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  /// Jeton qui a remplacé celui-ci lors d'une rotation. Sa présence signifie
  /// que ce jeton-ci a déjà servi.
  replacedById String? @map("replaced_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Access tokens révoqués avant leur expiration naturelle (déconnexion).
///
/// Un JWT est autoportant : on ne peut pas l'annuler, seulement tenir la liste
/// de ceux qu'on refuse. Comme ils vivent 15 minutes, cette table reste
/// minuscule — une purge périodique suffit à la vider.
model RevokedAccessToken {
  /// Identifiant unique du JWT (claim `jti`).
  jti String @id

  /// Fin de vie naturelle du jeton : au-delà, la ligne ne sert plus à rien.
  expiresAt DateTime @map("expires_at")

  revokedAt DateTime @default(now()) @map("revoked_at")

  @@index([expiresAt])
  @@map("revoked_access_tokens")
}

/// Jeton de confirmation d'adresse, envoyé par courriel à l'inscription.
///
/// Même principe que les autres jetons du service : seule l'empreinte est
/// stockée. Une fuite de la base ne permet pas de confirmer une adresse à la
/// place de son propriétaire.
model EmailVerification {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 du jeton envoyé dans le lien.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime  @map("expires_at")
  /// Rempli à la première utilisation : un lien de confirmation ne sert qu'une fois.
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// Défi de double authentification, émis à chaque connexion.
///
/// Le code à six chiffres n'est jamais stocké en clair : on garde son empreinte
/// argon2id, comme pour un mot de passe. Un code à six chiffres se casse en
/// quelques millisecondes avec SHA-256 ; argon2id rend l'essai coûteux même si
/// la base fuit pendant la fenêtre de validité.
model MfaChallenge {
  id String @id @default(uuid()) @db.Uuid

  /// Empreinte argon2id du code envoyé par courriel.
  codeHash String @map("code_hash")

  /// Nombre d'essais infructueux. Au-delà d'une poignée, le défi est clos :
  /// c'est ce qui rend l'énumération des 10^6 codes inutile.
  attempts Int @default(0)

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}