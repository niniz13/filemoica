# Modèle pour `docker-compose.deploy.yml`.
#
#   cp .env.deploy.example .env.deploy
#
# Puis remplacer les trois clés. `.env.deploy` est exclu de git : il ne doit
# jamais y entrer, et ne doit **jamais** être rangé au même endroit que les
# sauvegardes — les deux réunis rendent les fichiers déchiffrables.

# --- Base de données -------------------------------------------------------
POSTGRES_USER=filemoica
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=filemoica

# --- Secrets ---------------------------------------------------------------
# Trois valeurs de 64 caractères hexadécimaux, **différentes entre elles** :
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Perdre ENCRYPTION_KEY_V1 rend tous les fichiers irrécupérables. Perdre
# JWT_SECRET est sans gravité : tout le monde se reconnecte.
JWT_SECRET=a-remplacer-au-moins-32-caracteres
ENCRYPTION_KEY_V1=a-remplacer-64-caracteres-hexadecimaux
HMAC_INDEX_KEY=a-remplacer-64-caracteres-hexadecimaux

# --- Exposition ------------------------------------------------------------
# Origine exacte du front. Sert au CORS et à la défense CSRF : une seule
# origine, jamais de joker.
FRONTEND_ORIGIN=http://localhost:5173

# Port sur la boucle locale de l'hôte. C'est le reverse proxy qui expose
# le service au public, en HTTPS.
APP_PORT=3000

# Nombre de relais devant le service. 1 derrière un reverse proxy.
TRUST_PROXY_HOPS=0

# Version affichée par /health. À renseigner avec le tag git au déploiement.
APP_VERSION=dev
