# ---------------------------------------------------------------------------
# Configuration du backend filemoica
#
# Copier ce fichier en `.env` et remplacer les valeurs.
# `.env` est ignoré par git : AUCUN secret réel ne doit être versionné.
#
# Générer une clé de 32 octets :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=3000

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://filemoica:motdepasse@localhost:5432/filemoica

# --- Sessions --------------------------------------------------------------
# Secret de signature des access tokens, 32 caractères minimum.
JWT_SECRET=
# Durée de vie de l'access token. Court par choix : un cookie volé n'est
# exploitable que pendant cette fenêtre.
JWT_ACCESS_TTL=15m
# Durée de vie du refresh token, en jours.
REFRESH_TOKEN_TTL_DAYS=7

# --- Stockage --------------------------------------------------------------
# Répertoire des fichiers chiffrés. À monter sur un volume sauvegardé en
# production (décision à arbitrer avec SRC).
STORAGE_PATH=./storage

# --- Chiffrement au repos --------------------------------------------------
# Clé maître (KEK) : 64 caractères hexadécimaux = 32 octets.
# Elle ne chiffre pas les fichiers directement, mais la clé propre à chaque
# fichier — c'est ce qui rend la rotation rapide.
ENCRYPTION_KEY_V1=
# Renseignée uniquement pendant une rotation de clés, puis V1 est retirée.
# ENCRYPTION_KEY_V2=

# Clé de l'index aveugle : permet de comparer les emails de destinataires
# sans les déchiffrer. Doit être différente de ENCRYPTION_KEY_V1.
HMAC_INDEX_KEY=

# --- Front / CORS ----------------------------------------------------------
# Origine exacte du front, sans slash final. Sert au CORS et à la défense CSRF.
FRONTEND_ORIGIN=http://localhost:5173
# Domaine des cookies. Vide en local, renseigné par SRC en production.
# COOKIE_DOMAIN=
