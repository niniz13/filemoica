# ---------------------------------------------------------------------------
# Configuration du backend filemoica
#
# Copier ce fichier en `.env` et remplacer les valeurs.
# `.env` est ignoré par git : AUCUN secret réel ne doit être versionné.
#
# Générer une clé de 32 octets :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=3000

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://filemoica:motdepasse@localhost:5433/filemoica

# --- Sessions --------------------------------------------------------------
# Secret de signature des access tokens, 32 caractères minimum.
JWT_SECRET=
# Durée de vie de l'access token. Court par choix : un cookie volé n'est
# exploitable que pendant cette fenêtre.
JWT_ACCESS_TTL=15m
# Durée de vie du refresh token, en jours.
REFRESH_TOKEN_TTL_DAYS=7

# --- Offres et quotas ------------------------------------------------------
# Taille maximale d'un fichier, en mégaoctets.
MAX_FILE_SIZE_MB=200
# Volume mensuel de dépôt inclus dans chaque offre, en mégaoctets.
# Dans la configuration pour pouvoir ajuster l'offre sans redéployer le code.
FREE_PLAN_QUOTA_MB=200
PREMIUM_PLAN_QUOTA_MB=20480
# Durée de conservation d'un fichier, en jours. Comptée depuis la fin de son
# dernier partage — pas depuis son dépôt : un fichier partagé pour 30 jours
# survit donc à son lien, et le délai ne commence à courir qu'ensuite.
FREE_PLAN_RETENTION_DAYS=30
PREMIUM_PLAN_RETENTION_DAYS=90

# --- Envoi de courriels (Brevo) ----------------------------------------------
# Laisser vide en développement : le contenu des courriels est alors écrit dans
# les journaux au lieu d'être envoyé, ce qui permet de travailler sans compte
# Brevo ni réseau. Le code de connexion à six chiffres s'y lit directement.
#
# En production, l'absence de clé fait échouer le démarrage : un code écrit
# dans les journaux n'est plus un secret.
BREVO_API_KEY=
# Doit être une adresse validée dans Brevo, sinon les envois sont refusés.
MAIL_FROM_ADDRESS=martin.simn91@gmail.com
MAIL_FROM_NAME=filemoica
# Base des liens de confirmation envoyés par courriel.
APP_PUBLIC_URL=http://localhost:3001

# --- Stockage --------------------------------------------------------------
# Répertoire des fichiers chiffrés. À monter sur un volume sauvegardé en
# production (décision à arbitrer avec SRC).
STORAGE_PATH=./storage

# --- Chiffrement au repos --------------------------------------------------
# Clé maître (KEK) : 64 caractères hexadécimaux = 32 octets.
# Elle ne chiffre pas les fichiers directement, mais la clé propre à chaque
# fichier — c'est ce qui rend la rotation rapide.
ENCRYPTION_KEY_V1=
# Renseignée uniquement pendant une rotation de clés, puis V1 est retirée.
# ENCRYPTION_KEY_V2=

# Clé de l'index aveugle : permet de comparer les emails de destinataires
# sans les déchiffrer. Doit être différente de ENCRYPTION_KEY_V1.
HMAC_INDEX_KEY=

# --- Front / CORS ----------------------------------------------------------
# Origine exacte du front, sans slash final. Sert au CORS et à la défense CSRF.
FRONTEND_ORIGIN=http://localhost:3001
# Domaine des cookies. Vide en local, renseigné par SRC en production.
# COOKIE_DOMAIN=

# --- Documentation ---------------------------------------------------------
# Expose la documentation interactive sur /api/docs.
# Activée par défaut. La couper en production réduit ce qu'un attaquant peut
# apprendre de la surface de l'API.
ENABLE_API_DOCS=true
