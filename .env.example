# Configuration de `docker compose up` à la racine du projet.
#
#   cp .env.example .env
#j
# `.env` est ignoré par git : aucun secret réel ne doit être versionné.
# Ce fichier ne concerne que le lancement local de toute la pile en conteneurs
# (voir docker-compose.yml). Pour le déploiement de production, voir
# backend/.env.deploy.example à la place.

# --- Base de données -------------------------------------------------------
POSTGRES_USER=filemoica
POSTGRES_PASSWORD=filemoica
POSTGRES_DB=filemoica
# Port exposé sur la machine hôte. 5433 et non 5432 : un PostgreSQL installé
# en local occupe déjà le port standard.
POSTGRES_PORT=5433

# --- Secrets du backend ------------------------------------------------------
# Trois valeurs de 64 caractères hexadécimaux (32 octets), différentes entre
# elles. Générer chacune avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY_V1=
HMAC_INDEX_KEY=

# --- Ports exposés sur la machine hôte --------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=3001

# --- Adresses ----------------------------------------------------------------
# Origine exacte du front, telle qu'exposée sur la machine hôte.
FRONTEND_ORIGIN=http://localhost:3001
# Url de l'API telle que le navigateur du visiteur doit la joindre. Inlinée
# dans le frontend au moment du build : la changer exige de reconstruire
# l'image (`docker compose up --build`).
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Envoi de courriels (facultatif en local) --------------------------------
# Sans clé, les messages ne partent pas : ils sont écrits dans les journaux du
# backend, lisibles avec `docker compose logs backend`. C'est suffisant pour
# essayer l'inscription et la double authentification sans compte Brevo.
#
# Avec une clé, les courriels partent réellement — l'adresse d'expédition doit
# alors être validée dans Brevo, sinon tous les envois sont refusés.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@filemoica.local
MAIL_FROM_NAME=filemoica
# Base des liens envoyés par courriel : l'adresse du **front**, pas de l'API.
APP_PUBLIC_URL=http://localhost:3001
